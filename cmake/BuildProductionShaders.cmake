# Local build reuse only. The published shader package format remains unchanged.
foreach(required SHADER_TOOL SHADER_LIBRARY SHADERC PLATFORM PROFILE PACKAGE TOOL_SOURCE INCLUDE_ROOTS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing production shader argument: ${required}")
    endif()
endforeach()
get_filename_component(package_name "${PACKAGE}" NAME)
get_filename_component(package_parent "${PACKAGE}" DIRECTORY)
if(package_name STREQUAL "")
    message(FATAL_ERROR "Invalid production shader package directory")
endif()
file(MAKE_DIRECTORY "${package_parent}")
set(state "${PACKAGE}.inputs")
file(LOCK "${state}.lock" GUARD PROCESS TIMEOUT 180)
function(production_input_key output)
    set(identity "AYRenderer-production-inputs-v1\n${PLATFORM}\n${PROFILE}\n")
    foreach(input "${SHADER_LIBRARY}" "${SHADERC}" "${TOOL_SOURCE}" "${CMAKE_CURRENT_LIST_FILE}")
        file(SHA256 "${input}" digest)
        string(APPEND identity "${input}\n${digest}\n")
    endforeach()
    set(include_files)
    foreach(root IN LISTS INCLUDE_ROOTS)
        if(NOT IS_DIRECTORY "${root}")
            message(FATAL_ERROR "Missing shader include root: ${root}")
        endif()
        string(APPEND identity "include-root:${root}\n")
        file(GLOB_RECURSE paths LIST_DIRECTORIES FALSE "${root}/*.sh" "${root}/*.sc"
            "${root}/*.h" "${root}/*.inc" "${root}/*.glsl" "${root}/*.hlsl")
        list(APPEND include_files ${paths})
    endforeach()
    list(REMOVE_DUPLICATES include_files)
    list(SORT include_files)
    foreach(input IN LISTS include_files)
        file(SHA256 "${input}" digest)
        string(APPEND identity "${input}\n${digest}\n")
    endforeach()
    string(SHA256 key "${identity}")
    set(${output} "${key}" PARENT_SCOPE)
endfunction()
production_input_key(key)
set(manifest "${PACKAGE}/manifest.json")
if(EXISTS "${manifest}" AND EXISTS "${state}")
    file(SHA256 "${manifest}" package_digest)
    file(READ "${state}" previous)
    if(previous STREQUAL "${key}\n${package_digest}\n")
        execute_process(COMMAND "${SHADER_TOOL}" "${PLATFORM}" "${PROFILE}" "${PACKAGE}" --check
            RESULT_VARIABLE status OUTPUT_VARIABLE validation ERROR_VARIABLE diagnostics)
        if("${status}" STREQUAL "0")
            production_input_key(confirmed_key)
            if(NOT confirmed_key STREQUAL key)
                message(FATAL_ERROR "Production shader inputs changed during validation; retry the build")
            endif()
            # The tool may have relinked because of unrelated Renderer code.
            # Refresh only the CMake output timestamp, preserving package bytes.
            file(TOUCH "${manifest}")
            string(STRIP "${validation}" validation)
            message(STATUS "Reused production shaders: ${validation}")
            return()
        endif()
    endif()
endif()
execute_process(COMMAND "${SHADER_TOOL}" "${PLATFORM}" "${PROFILE}" "${PACKAGE}"
    RESULT_VARIABLE status)
if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Production shader build failed: ${status}")
endif()
file(SHA256 "${manifest}" package_digest)
file(WRITE "${state}.tmp" "${key}\n${package_digest}\n")
file(RENAME "${state}.tmp" "${state}")
